{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Train LSS",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/LiftSplatShoot/train_LSS.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/carla_garage", 
            "env": {
                "CARLA_GARAGE_ROOT": "${workspaceFolder}/carla_garage",
                "WORK_DIR": "${workspaceFolder}/carla_garage",
                "COMMON_LIBRARY_ROOT": "${workspaceFolder}/common_library",
                "SCENARIO_RUNNER_ROOT": "${workspaceFolder}/carla_garage/scenario_runner_autopilot",
                "LEADERBOARD_ROOT": "${workspaceFolder}/carla_garage/leaderboard_autopilot",
                "CARLA_PYTHONAPI_ROOT": "${workspaceFolder}/carla_garage/carla/PythonAPI/carla",
                "TEAM_CODE_ROOT": "${workspaceFolder}/carla_garage/team_code",
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}/carla_garage/carla/PythonAPI/carla:${workspaceFolder}/carla_garage/scenario_runner_autopilot:${workspaceFolder}/carla_garage/leaderboard_autopilot:${workspaceFolder}/carla_garage/team_code:${workspaceFolder}/common_library:${workspaceFolder}"
            },
            "args": [
                "--data=${workspaceFolder}/logs/dataset",
                "--save_path=${workspaceFolder}/pretrained_models/LSS"
            ]
        },
        {
            "name": "Analyze data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/LiftSplatShoot/Analysis/analyze_data.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/carla_garage",
            "env": {
                "CARLA_GARAGE_ROOT": "${workspaceFolder}/carla_garage",
                "WORK_DIR": "${workspaceFolder}/carla_garage",
                "COMMON_LIBRARY_ROOT": "${workspaceFolder}/common_library",
                "SCENARIO_RUNNER_ROOT": "${workspaceFolder}/carla_garage/scenario_runner_autopilot",
                "LEADERBOARD_ROOT": "${workspaceFolder}/carla_garage/leaderboard_autopilot",
                "CARLA_PYTHONAPI_ROOT": "${workspaceFolder}/carla_garage/carla/PythonAPI/carla",
                "TEAM_CODE_ROOT": "${workspaceFolder}/carla_garage/team_code",
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}/carla_garage/carla/PythonAPI/carla:${workspaceFolder}/carla_garage/scenario_runner_autopilot:${workspaceFolder}/carla_garage/leaderboard_autopilot:${workspaceFolder}/carla_garage/team_code:${workspaceFolder}/common_library:${workspaceFolder}"
            }
        }
    ]
}